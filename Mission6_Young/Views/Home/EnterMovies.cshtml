@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model Movie

<h1>Enter a Movie</h1>

@* Page using the shared layout that has receives the user input and saves it as a response object *@

<form method="post">
    
    <input type="hidden" asp-for="MovieId"> @* Pass in the movie ID but don't let user see it *@
    
    <select asp-for="CategoryId">
        <option value="">Category:</option>
        @foreach (Category c in ViewBag.Categories)
        {
            <option value="@c.CategoryId">@c.CategoryName</option> @*Grab the CategoryId and save it as the value while
                                                                    displaying the category name*@
        }
    </select>
    
    <br/>
    <label asp-for="Title">Title:</label>
    <input asp-for="Title"/>
    <br/>
    <label asp-for="Year">Year:</label>
    <input asp-for="Year"/>
    <br/>
    <label asp-for="Director">Director:</label>
    <input asp-for="Director"/>
    <br/>
    <label asp-for="Rating">Rating:</label>
    <select asp-for="Rating" asp-items="Html.GetEnumSelectList<Rating>()" class="form-control"></select>
    <br/>
    <label asp-for="Edited">Edited?</label>
    <select asp-for="Edited">
        <option value="false">No</option> @* No is selected by default *@
        <option value="true">Yes</option>
    </select>
    <br/>
    <label asp-for="LentTo">Lent to:</label>
    <input asp-for="LentTo"/>
    <br/>
    <label asp-for="Notes">Notes:</label>
    <input asp-for="Notes"/>
    <br/>

    <button type="submit">Enter Movie</button>
</form>