@{
}

@model List<Movie>

<table class="table table striped table-bordered table hover">
    <thead class="fw-bold">
    <tr>
        <td>Category</td>
        <td>Title</td>
        <td>Year</td>
        <td>Director</td>
        <td>Rating</td>
        <td>Edited</td>
        <td>Lent to</td>
        <td>Copied to Plex</td>
        <td>Notes</td>
    </tr>
    </thead>

    @foreach (var x in Model)
    {
        <tbody>
        <tr>
            <td>@x.Category.CategoryName</td>
            <td>@x.Title</td>
            <td>@x.Year</td>
            <td>@x.Director</td>
            <td>@x.Rating</td>
            <td>@x.Edited</td>
            <td>@x.LentTo</td>
            <td>@x.CopiedToPlex</td>
            <td>@x.Notes</td>

            <td><a class="btn btn-primary btn-sm" asp-controller="Home" asp-action="EditMovie" asp-route-movieId="@x.MovieId">Edit</a></td>
            <td><a class="btn btn-danger btn sm" asp-controller="Home" asp-action="DeleteMovie" asp-route-movieId="@x.MovieId">Delete</a></td>

        </tr>

        </tbody>
    }

</table>